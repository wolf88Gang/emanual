# ONVO Pay — payment gateway
#
# Do NOT put any key in the source code. Save them as project secrets
# (Project Settings > Secrets) so the payment functions read them at runtime.
#
# Switch between fake payments and real money by changing ONVO_ENV only:
#   test -> ONVO test cards, no real charges
#   live -> real money (default when ONVO_ENV is empty)
ONVO_ENV=live

# Test pair (onvo_test_secret_key_... + the webhook secret of the test webhook)
ONVO_SECRET_KEY_TEST=
ONVO_WEBHOOK_SECRET_TEST=

# Live pair (onvo_live_secret_key_... + the webhook secret of the live webhook)
ONVO_SECRET_KEY_LIVE=
ONVO_WEBHOOK_SECRET_LIVE=

# Legacy single pair. Still honoured as a fallback when the pair above for the
# active ONVO_ENV is not configured.
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
