# ONVO Pay — payment gateway
#
# Do NOT put the secret key in the source code. Save it as a project secret
# (Project Settings > Secrets) so the payment functions read it at runtime.
#
# Test key:  onvo_test_secret_key_...
# Live key:  onvo_live_secret_key_...
ONVO_SECRET_KEY=

# Secret shown next to the webhook you create in the ONVO dashboard.
# ONVO sends it in the X-Webhook-Secret header of every webhook call.
ONVO_WEBHOOK_SECRET=
